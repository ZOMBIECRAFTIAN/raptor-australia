# ─── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.pytest_cache/
results/pytest-basetemp/
results/pytest-temp/
.mypy_cache/

# ─── Virtual environments ──────────────────────────────
.venv/
.venv-modern/
venv/
env/
raptor_env/
ENV/
env.bak/
venv.bak/
.tmp-pip/
.pip-cache/

# ─── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/

# ─── IDEs / Editors ────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ─── Environment / secrets ─────────────────────────────
.env
.env.*
*.key
*.pem

# ─── Project-specific: large datasets ──────────────────
# Raw image dataset (re-downloadable via notebooks/download_ala_images.py;
# rebuild processed splits with notebooks/retrain.py)
dataset/raw/
dataset/processed/
dataset/feedback/
dataset/raw_archive/        # quality-filter rejects — re-derivable

# ─── Project-specific: model weights ───────────────────
# .pth/.pt files exceed GitHub's 100 MB per-file limit.
# Train via notebooks/retrain.py to reproduce best_model.pth.
models/*.pth
models/*.pt
models/checkpoints/

# ─── Project-specific: user-generated CSVs ─────────────
# These accumulate per-deployment user data; not part of the codebase.
results/observations.csv
results/feedback_log.csv

# ─── Project-specific: regeneratable artefacts ─────────
# Legacy hero candidate artifacts are not part of the v1.5 release.
results/hero_candidates_*.jpg
results/hero_scores.csv

# ─── Flask uploads ─────────────────────────────────────
gui/uploads/
!gui/uploads/.gitkeep

# ─── Conversation exports & assistant scratch files ────
# Any *_chat_export.md or stray text dumps from AI-assisted
# work belong in the local workspace, never in version control.
raptor_chat_export.md
*_chat_export.md
chat_export*.md
# Empty/garbage zero-byte files (eg. accidental "python" file
# created by shell mishaps)
python
node
